MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=shopzone

AUTH_SECRET=a-long-random-string

# Comma-separated addresses that become admins on first sign-in.
ADMIN_EMAILS=you@gmail.com
PUBLIC_ORIGIN=http://localhost:3000

# Google sign-in — leave blank to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

API_PORT=3000

# Where new-order alerts are sent.
ORDERS_EMAIL_TO=manager@yourstore.com

# SMTP. Gmail needs an App Password, not the account password.
# Leave SMTP_USER/SMTP_PASS blank to log emails to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Your Store <manager@yourstore.com>
