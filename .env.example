MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=shopzone

# Signs every session token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to treat a placeholder or anything under 24 characters as
# configured, and warns at boot.
AUTH_SECRET=a-long-random-string

# Set to "production" when deployed. Turns on HSTS and upgrade-insecure-requests.
NODE_ENV=development

# How many reverse proxies sit in front of the app. 1 is right for nginx,
# Railway, Render and most PaaS. Getting this wrong makes rate limiting treat
# every visitor as the same person.
TRUST_PROXY=1

# Comma-separated addresses that become admins on first sign-in.
ADMIN_EMAILS=you@gmail.com
PUBLIC_ORIGIN=http://localhost:3000

# Google sign-in — leave blank to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

API_PORT=3000

# Where new-order alerts are sent.
ORDERS_EMAIL_TO=manager@yourstore.com

# SMTP. Gmail needs an App Password, not the account password.
# Leave SMTP_USER/SMTP_PASS blank to log emails to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Your Store <manager@yourstore.com>
