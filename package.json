{
  "name": "shopzone",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently -n api,web -c cyan,green \"npm:serve:api\" \"npm:start\"",
    "start": "ng serve",
    "serve:api": "node --watch server/index.mjs",
    "serve:prod": "node server/index.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "icons": "node scripts/make-icons.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:reset": "node scripts/seed-db.mjs --fresh",
    "screens": "node scripts/capture-screens.mjs",
    "report": "node scripts/build-report.mjs",
    "docker:build": "docker build -t mr-enginero .",
    "docker:run": "docker run --rm --init -p 3000:3000 --env-file .env -e NODE_ENV=production -e TRUST_PROXY=0 mr-enginero"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "mongodb": "^6.12.0",
    "nodemailer": "^9.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.1.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.35.3",
    "typescript": "~5.6.0"
  }
}
